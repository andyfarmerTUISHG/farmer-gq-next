{
  "name": "farmer.gq-next.js",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typegen && next build && sanity manifest extract --path public/studio/static",
    "predev": "npm run typegen",
    "clean": "rm -rf .next",
    "dev-old": "next dev",
    "dev": "next dev --turbopack",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "lint:dry-run": "eslint . --fix-dry-run",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "typegen": "sanity schema extract && sanity typegen generate",
    "sanity-build": "sanity build",
    "sanity-deploy": "sanity deploy",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:auth": "vitest --run --reporter=verbose auth",
    "test:films": "vitest --run --reporter=verbose film",
    "test:books": "vitest --run --reporter=verbose book",
    "test:watch:auth": "vitest --reporter=verbose auth",
    "test:watch:films": "vitest --reporter=verbose film",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@next/env": "^16.3.3",
    "@sanity/block-content-to-react": "3.0.0",
    "@sanity/client": "^8.4.0",
    "@sanity/code-input": "7.3.7",
    "@sanity/image-url": "2.1.1",
    "@sanity/react-loader": "^2.2.1",
    "@sanity/schema": "^6.11.0",
    "@sanity/ui": "^4.0.7",
    "@sanity/vision": "^6.11.0",
    "@sanity/visual-editing": "^6.1.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/typography": "0.5.20",
    "better-auth": "^1.7.2",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "next-sanity": "^13.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "5.7.0",
    "react-is": "^19.2.8",
    "react-live-transitions": "0.2.0",
    "react-syntax-highlighter": "16.1.1",
    "rxjs": "7.8.2",
    "sanity": "^6.11.0",
    "sanity-plugin-asset-source-unsplash": "7.0.25",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "styled-components": "6.5.3",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@eslint-react/eslint-plugin": "^5.18.7",
    "@sanity/cli": "^8.9.1",
    "@sanity/mcp-server": "^0.12.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "10.5.4",
    "babel-plugin-react-compiler": "beta",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "next-devtools-mcp": "latest",
    "postcss": "^8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "$typescript"
  }
}
